# Copy this file to .env and fill in the values for your environment.

# Required: Django secret key used for cryptographic signing.
DJANGO_SECRET_KEY=replace-with-your-own-secret-key

# Set to True for local development, False for production.
DJANGO_DEBUG=True

# Comma-separated hostnames or IPs that can serve this app.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=meeting_transcriber
POSTGRES_TEST_DB=meeting_transcriber
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

HF_TOKEN=replace-with-your-hugging-face-access-token
